local function formatDiscordNumber(value)
    value = tonumber(value)

    if not value then
        return "ไม่ทราบ"
    end

    local formatted = tostring(math.floor(value))
        :reverse()
        :gsub("(%d%d%d)", "%1,")
        :reverse()

    return formatted:gsub("^,", "")
end

local function getDiscordGuildIcon(guild)
    if not guild or not guild.id or not guild.icon then
        return nil
    end

    return ("https://cdn.discordapp.com/icons/%s/%s.png?size=256"):format(
        tostring(guild.id),
        tostring(guild.icon)
    )
end

local function getDiscordAvatar(user)
    if not user or not user.id then
        return "https://cdn.discordapp.com/embed/avatars/0.png"
    end

    if user.avatar then
        return ("https://cdn.discordapp.com/avatars/%s/%s.png?size=128"):format(
            tostring(user.id),
            tostring(user.avatar)
        )
    end

    return "https://cdn.discordapp.com/embed/avatars/0.png"
end

