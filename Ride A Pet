local function CopyDiscordLink()
    local copied = false

    pcall(function()
        if setclipboard then
            setclipboard(DISCORD_INVITE_LINK)
            copied = true

        elseif toclipboard then
            toclipboard(DISCORD_INVITE_LINK)
            copied = true

        elseif getgenv and getgenv().setclipboard then
            getgenv().setclipboard(DISCORD_INVITE_LINK)
            copied = true

        elseif getgenv and getgenv().toclipboard then
            getgenv().toclipboard(DISCORD_INVITE_LINK)
            copied = true
        end
    end)

    if copied then
        notify(
            "F!exozy",
            "คัดลอกลิงก์ Discord แล้ว"
        )
    else
        notify(
            "F!exozy",
            DISCORD_INVITE_LINK
        )
    end
end

