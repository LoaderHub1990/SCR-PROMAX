			Title = "FPS: --",
			Icon = "gauge",
			Color = Color3.fromHex("#7C3AED"),
			Radius = 7
		})
	end)

	if ok and fpsTag then
		task.spawn(function()
			local RunService = game:GetService("RunService")
			local frames = 0
			local elapsed = 0

			while fpsTag and fpsTag.SetTitle do
				local connection
				local connected = true

				connection = RunService.Heartbeat:Connect(function(dt)
					if not connected then
						return
					end
					frames += 1
					elapsed += dt
				end)

				task.wait(1)
				connected = false
				if connection then
					connection:Disconnect()
				end

				local fps = math.floor(frames / math.max(elapsed, 0.001) + 0.5)
				pcall(function()
					fpsTag:SetTitle("FPS: " .. tostring(fps))
				end)
			end
		end)
	end
end

