local function LoadDiscordInfo()

    pcall(function()
        discordServerCard:SetTitle(
            "F!exozy Hub X | Discord"
        )

        discordServerCard:SetDesc(
            "กำลังโหลดข้อมูลเซิร์ฟเวอร์..."
        )
    end)

    local success, response = pcall(function()
        return game:HttpGet(DISCORD_API_URL)
    end)

    if not success or type(response) ~= "string" then

        pcall(function()
            discordServerCard:SetDesc(
                "ไม่สามารถโหลดข้อมูล Discord ได้"
            )
        end)

        return
    end

    local decoded, data = pcall(function()
        return HttpService:JSONDecode(response)
    end)

    if not decoded or type(data) ~= "table" then

        pcall(function()
            discordServerCard:SetDesc(
                "ข้อมูล Discord API ไม่ถูกต้อง"
            )
        end)

        return
    end

    if data.code and data.message and not data.guild then

        pcall(function()
            discordServerCard:SetDesc(
                tostring(data.message)
            )
        end)

        return
    end

    local guild = data.guild or {}
    local inviter = data.inviter or {}

    local guildName = tostring(
        guild.name or "Discord Server"
    )

    local memberCount = tonumber(
        data.approximate_member_count
    ) or 0

    local onlineCount = tonumber(
        data.approximate_presence_count
    ) or 0

    local guildIcon = getDiscordGuildIcon(guild)
    local ownerAvatar = getDiscordAvatar(inviter)

    pcall(function()

        discordServerCard:SetTitle(
            guildName
        )

        discordServerCard:SetDesc(
            "สมาชิก "
            .. formatDiscordNumber(memberCount)
            .. "  •  ออนไลน์ "
            .. formatDiscordNumber(onlineCount)
        )

        if guildIcon and discordServerCard.SetImage then
            discordServerCard:SetImage(
                guildIcon,
                64
            )
        end
    end)

    pcall(function()

        discordStatsCard:SetTitle(
            "สมาชิก"
        )

        discordStatsCard:SetDesc(
            "ออนไลน์  "
            .. formatDiscordNumber(onlineCount)
            .. "\n"
            .. "ทั้งหมด  "
            .. formatDiscordNumber(memberCount)
        )
    end)

    if inviter.username then

        local ownerName = tostring(
            inviter.global_name
            or inviter.username
        )

        local ownerUsername = "@"
            .. tostring(inviter.username)

        pcall(function()

            discordOwnerCard:SetTitle(
                "เจ้าของโดย  " .. ownerName
            )

            discordOwnerCard:SetDesc(
                ownerUsername
            )

            if ownerAvatar and discordOwnerCard.SetImage then
                discordOwnerCard:SetImage(
                    ownerAvatar,
                    48
                )
            end
        end)

    else

        pcall(function()

            discordOwnerCard:SetTitle(
                "เจ้าของโดย"
            )

            discordOwnerCard:SetDesc(
                "ไม่พบข้อมูลเจ้าของ"
            )
        end)
    end
end

