local function stopAntiPull()
    if antiPullConn then antiPullConn:Disconnect(); antiPullConn=nil end
end
local function startAntiPull(targetCFrame)
    stopAntiPull()
    antiPullConn = RunService.Heartbeat:Connect(function()
        local hrp = cfGetHRP()
        if not hrp then return end
        if (hrp.Position - targetCFrame.Position).Magnitude > 3 then
            hrp.CFrame = targetCFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

CFTab:Button({
    Title="วาร์ปไปตำแหน่ง", Desc="วาร์ปไปยังตำแหน่งที่บันทึกไว้", Icon="zap", Justify="Center",
    Callback=function()
        if warpTween then pcall(function() warpTween:Cancel() end); warpTween=nil end
        stopAntiPull()
        if not savedCFrame then WindUI:Notify({ Title="CFrame", Content="กรุณาบันทึกตำแหน่งก่อน!", Duration=2 }); return end
        local hrp = cfGetHRP()
        local hum = cfGetHuman()
        if not hrp or not hum then WindUI:Notify({ Title="CFrame", Content="ไม่พบ Character!", Duration=2 }); return end
        local target = savedCFrame
        if tweenMode == false then
            hrp.CFrame = target
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            startAntiPull(target)
            WindUI:Notify({ Title="Warp", Content="วาร์ปแล้ว! • Instant", Duration=2 })
            task.delay(2, function() stopAntiPull() end)
        else
            local distance = (hrp.Position - target.Position).Magnitude
            local duration = math.clamp(distance / math.max(tweenSpeed, 1), 0.1, 30)
            hum.PlatformStand = true
            warpTween = TweenService:Create(hrp,
                TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
                { CFrame = target })
            antiPullConn = RunService.Heartbeat:Connect(function()
                if hrp and hrp.Parent then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end)
            warpTween:Play()
            warpTween.Completed:Connect(function()
                stopAntiPull()
                if not hum or not hum.Parent then warpTween=nil; return end
                hum.PlatformStand = false
                if hrp and hrp.Parent then
                    hrp.CFrame = target
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
                WindUI:Notify({ Title="Warp", Content="ถึงตำแหน่งแล้ว! • Tween", Duration=2 })
                task.delay(2, function() stopAntiPull(); warpTween=nil end)
            end)
        end
    end
})

