local function FormatDiscordNumber(value)
    value = tonumber(value)
    if not value then
        return "ไม่ทราบ"
    end

    local formatted = tostring(math.floor(value))
        :reverse()
        :gsub("(%d%d%d)", "%1,")
        :reverse()

    return formatted:gsub("^,", "")
end

local function LoadDiscordInfo()
    local apiUrl = DiscordAPI

    pcall(function()
        DiscordCard:SetTitle("F!exozy X  | 128b!t Hub | Discord")
        DiscordCard:SetDesc("กำลังโหลดข้อมูล Discord...")
        if DiscordCard.SetImage then
            DiscordCard:SetImage("rbxassetid://112028775617493", 50)
        end
    end)

    local success, response = pcall(function()
        return game:HttpGet(apiUrl)
    end)

    if not success or type(response) ~= "string" then
        pcall(function()
            DiscordCard:SetDesc("ไม่สามารถโหลดข้อมูล Discord ได้")
        end)
        return
    end

    local decoded, data = pcall(function()
        return HttpService:JSONDecode(response)
    end)

    if not decoded or type(data) ~= "table" then
        pcall(function()
            DiscordCard:SetDesc("ข้อมูล Discord API ไม่ถูกต้อง")
        end)
        return
    end

    if data.code and data.message and not data.guild then
        pcall(function()
            DiscordCard:SetDesc(tostring(data.message))
        end)
        return
    end

    local guild = data.guild or {}
    local guildName = tostring(guild.name or "Discord Server")
    local memberCount = tonumber(data.approximate_member_count) or 0
    local onlineCount = tonumber(data.approximate_presence_count) or 0

    pcall(function()
        DiscordCard:SetTitle(guildName .. " | Discord")
        DiscordCard:SetDesc(
            "discord support | สมาชิก "
            .. FormatDiscordNumber(memberCount)
            .. " • ออนไลน์ "
            .. FormatDiscordNumber(onlineCount)
        )

        if DiscordCard.SetImage then
            DiscordCard:SetImage("rbxassetid://112028775617493", 50)
        end
    end)
end

