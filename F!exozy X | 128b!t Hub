local function getVisContainer(player)
    local name="VIS_"..player.Name
    local c=VisESPFolder:FindFirstChild(name)
    if not c then c=Instance.new("Folder"); c.Name=name; c.Parent=VisESPFolder end
    return c
end
local function clearVisPlayer(player)
    local c=VisESPFolder:FindFirstChild("VIS_"..player.Name)
    if c then c:Destroy() end
end
local function buildESP(player)
    if player==LocalPlayer then return end
    local char=player.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local container=getVisContainer(player)

    local hl=container:FindFirstChildOfClass("Highlight")
    if VisState.HighlightOn or VisState.ESP then
        if not hl then
            hl=Instance.new("Highlight")
            hl.Adornee=char
            hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent=container
        end
        hl.FillColor=VisState.FillColor
        hl.OutlineColor=VisState.OutlineColor
        hl.FillTransparency=VisState.FillTrans
        hl.OutlineTransparency=VisState.OutlineTrans
    else
        if hl then hl:Destroy() end
    end

    local bb=container:FindFirstChild("ESPBillboard")
    if VisState.NameESP or VisState.Distance then
        if not bb then
            bb=Instance.new("BillboardGui")
            bb.Name="ESPBillboard"; bb.Adornee=hrp; bb.AlwaysOnTop=true
            bb.Size=UDim2.new(0,120,0,40); bb.StudsOffset=Vector3.new(0,3,0); bb.Parent=container
            local lbl=Instance.new("TextLabel")
            lbl.Name="Label"; lbl.BackgroundTransparency=1; lbl.Size=UDim2.fromScale(1,1)
            lbl.TextColor3=Color3.fromRGB(255,255,255); lbl.TextStrokeTransparency=0.4
            lbl.TextScaled=true; lbl.Font=Enum.Font.GothamBold; lbl.Text=player.Name; lbl.Parent=bb
        end
    else
        if bb then bb:Destroy() end
    end

    local tracer=container:FindFirstChild("ESPTracer")
    if VisState.Tracer then
        if not tracer then
            tracer=Instance.new("SelectionBox")
            tracer.Name="ESPTracer"; tracer.Adornee=hrp; tracer.LineThickness=0.05
            tracer.SurfaceTransparency=1; tracer.SurfaceColor3=Color3.fromRGB(0,0,0); tracer.Parent=container
        end
        tracer.Color3=VisState.FillColor
    else
        if tracer then tracer:Destroy() end
    end
end

local function rebuildAll()
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer then
            local anyOn=VisState.ESP or VisState.Tracer or VisState.NameESP or VisState.Distance or VisState.HighlightOn
            if anyOn and p.Character then buildESP(p) else clearVisPlayer(p) end
        end
    end
end

RunService.Heartbeat:Connect(function()
    if not (VisState.NameESP or VisState.Distance) then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        local char=p.Character; if not char then continue end
        local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then continue end
        local container=VisESPFolder:FindFirstChild("VIS_"..p.Name); if not container then continue end
        local bb=container:FindFirstChild("ESPBillboard"); if not bb then continue end
        local lbl=bb:FindFirstChild("Label"); if not lbl then continue end
        local myHRP=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist=myHRP and math.floor((hrp.Position-myHRP.Position).Magnitude) or 0
        local text=""
        if VisState.NameESP then text=p.Name end
        if VisState.Distance then text=text..(VisState.NameESP and ("\n"..dist.." studs") or (dist.." studs")) end
        lbl.Text=text
    end
end)

