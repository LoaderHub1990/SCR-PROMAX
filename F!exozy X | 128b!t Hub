local killAllActive = false
local killAllConn = nil

local function startKillAll()
    if killAllActive then return end
    killAllActive = true

    killAllConn = RunService.Heartbeat:Connect(function()
        if not killAllActive then return end

        local myChar = LocalPlayer.Character
        if not myChar then return end

        -- หา Tool ที่มี Handle ใน Character
        local tool = nil
        for _, obj in ipairs(myChar:GetChildren()) do
            if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                tool = obj
                break
            end
        end

        -- ถ้าไม่มีใน Character ไปหาใน Backpack แล้ว equip
        if not tool then
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
            if bp then
                for _, obj in ipairs(bp:GetChildren()) do
                    if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                        local hum = myChar:FindFirstChildOfClass("Humanoid")
                        if hum then
                            hum:EquipTool(obj)
                            task.wait(0.15)
                            tool = myChar:FindFirstChild(obj.Name)
                        end
                        break
                    end
                end
            end
        end

        if not tool or not tool:FindFirstChild("Handle") then return end

        tool:Activate()

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    for _, part in ipairs(p.Character:GetChildren()) do
                        if part:IsA("BasePart") then
                            firetouchinterest(tool.Handle, part, 0)
                            firetouchinterest(tool.Handle, part, 1)
                        end
                    end
                end
            end
        end
    end)

end

local function stopKillAll()
    killAllActive = false
    if killAllConn then
        killAllConn:Disconnect()
        killAllConn = nil
    end
end

