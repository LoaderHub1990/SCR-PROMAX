local SelectedPlayer = nil
local PlayerList = {}

local function RefreshPlayers()
    PlayerList = {}

    for _, player in ipairs(
        Players:GetPlayers()
    ) do
        if player ~= LocalPlayer then
            table.insert(
                PlayerList,
                player.Name
            )
        end
    end

    table.sort(PlayerList)
end

RefreshPlayers()

local PlayerDropdown = PlayerTab:Dropdown({
    Title = "Target Player",

    Desc = "เลือกผู้เล่นที่จะ Teleport",

    Values =
        #PlayerList > 0
        and PlayerList
        or {"Nobody Online"},

    Multi = false,

    Callback = function(value)
        if type(value) == "table" then
            SelectedPlayer = value[1]
        else
            SelectedPlayer = value
        end

        flags.targetPlayer =
            SelectedPlayer or ""
    end
})

task.spawn(function()
    local lastRoster = ""

    while true do
        task.wait(2)

        RefreshPlayers()

        local signature =
            table.concat(
                PlayerList,
                "|"
            )

        if signature ~= lastRoster then
            lastRoster = signature

            local values =
                #PlayerList > 0
                and PlayerList
                or {"Nobody Online"}

            pcall(function()
                if PlayerDropdown.Refresh then
                    PlayerDropdown:Refresh(values)
                end
            end)
        end
    end
end)

