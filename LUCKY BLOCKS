local function GetRequestFunction()
    if typeof(request) == "function" then
        return request
    end

    if typeof(http_request) == "function" then
        return http_request
    end

    if syn and typeof(syn.request) == "function" then
        return syn.request
    end

    if http and typeof(http.request) == "function" then
        return http.request
    end

    return nil
end

local function FormatNumber(number)
    number = tonumber(number) or 0

    local value = tostring(math.floor(number))

    local result =
        value
        :reverse()
        :gsub("(%d%d%d)", "%1,")
        :reverse()

    return result:gsub("^,", "")
end

local DiscordInfo = {
    Name = "Discord",
    Icon = LOGO_ID,
    Online = 0,
    Offline = 0,
    Members = 0,
    Success = false
}

local function FetchDiscord()
    local requestFunction = GetRequestFunction()

    if not requestFunction then
        DiscordInfo.Success = false
        return false
    end

    local success, response = pcall(function()
        return requestFunction({
            Url =
                "https://discord.com/api/v10/invites/"
                .. DISCORD_CODE
                .. "?with_counts=true",

            Method = "GET"
        })
    end)

    if not success
        or not response
        or response.StatusCode ~= 200
        or not response.Body then

        DiscordInfo.Success = false
        return false
    end

    local jsonSuccess, data = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not jsonSuccess or type(data) ~= "table" then
        DiscordInfo.Success = false
        return false
    end

    local guild = data.guild

    if type(guild) ~= "table" then
        DiscordInfo.Success = false
        return false
    end

    local online =
        tonumber(data.approximate_presence_count)
        or 0

    local members =
        tonumber(data.approximate_member_count)
        or 0

    local offline =
        math.max(members - online, 0)

    DiscordInfo.Name =
        tostring(guild.name or "Discord")

    DiscordInfo.Online = online
    DiscordInfo.Offline = offline
    DiscordInfo.Members = members
    DiscordInfo.Success = true

    if guild.id and guild.icon then
        DiscordInfo.Icon =
            "https://cdn.discordapp.com/icons/"
            .. tostring(guild.id)
            .. "/"
            .. tostring(guild.icon)
            .. ".png?size=128"
    else
        DiscordInfo.Icon = LOGO_ID
    end

    return true
end

FetchDiscord()

local function GetInventoryCount()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    if not backpack then
