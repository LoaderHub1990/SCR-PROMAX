local function StartKeyMonitor()
    task.spawn(function()
        while not Kicked do
            task.wait(CHECK_INTERVAL)

            if Kicked or not CurrentKey then
                continue
            end

            local ok, status, data = pcall(VerifyKey, CurrentKey)

            if not ok then
                status = "error"
            end

            if status == "valid" then
                FailCount = 0
                ApplyKeyData(data)

                if KeyExpireTime and KeyExpireTime - Now() <= 0 then
                    KickPlayer("คีย์หมดอายุแล้ว")
                    return
                end
            elseif status == "invalid" then
                KickPlayer("คีย์ถูกปิดใช้งานหรือหมดอายุ")
                return
            else
                FailCount += 1

                if KICK_ON_OFFLINE and FailCount >= OFFLINE_WARN_AFTER * 2 then
                    KickPlayer("ไม่สามารถตรวจสอบคีย์ได้")
                    return
                end
            end
        end
    end)
end

