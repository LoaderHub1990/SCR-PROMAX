                    key = tostring(key or ""):gsub("%s+", "")

                    if key == "" then
                        return false, "กรุณากรอกคีย์"
                    end

                    local request = ctx.Request

                    if not request then
                        return false, "ไม่พบ HTTP Request"
                    end

                    local success, response = pcall(function()
                        return request({
                            Url = "https://api-key4258-three.vercel.app/api/verify?key="
                                .. HttpService:UrlEncode(key),
                            Method = "GET"
                        })
                    end)

                    if not success then
                        return false, "เชื่อมต่อ API ไม่สำเร็จ"
                    end

                    if not response or response.StatusCode ~= 200 then
                        return false, "API Error: "
                            .. tostring(response and response.StatusCode or "Unknown")
                    end

                    local decodeSuccess, data = pcall(function()
                        return HttpService:JSONDecode(response.Body)
                    end)

                    if not decodeSuccess or type(data) ~= "table" then
                        return false, "ข้อมูลจาก API ไม่ถูกต้อง"
                    end

                    if data.valid == true then
                        CurrentKey = key

                        KeyExpireTime =
                            tonumber(data.expiresAt)
                            or tonumber(data.expireAt)
                            or tonumber(data.expires)
                            or tonumber(data.expiry)

                        return true
                    end

                    return false, "คีย์ไม่ถูกต้อง หรือหมดอายุแล้ว"
                end,

                GetKeyLink = function(ctx)
                    return "https://api-key4258-three.vercel.app/getkey/flexozy-key24h"
