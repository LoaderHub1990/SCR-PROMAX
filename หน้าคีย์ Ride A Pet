local function Now()
    return os.time() + TimeOffset
end

local function NormalizeTime(n)
    n = tonumber(n)
    if not n then
        return nil
    end
    if n > 1e11 then
        n = math.floor(n / 1000)
    end
    return n
end

local function FormatTime(seconds)
    seconds = math.max(0, math.floor(seconds))

    local days = math.floor(seconds / 86400)
    local hours = math.floor((seconds % 86400) / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60

    if days > 0 then
        return string.format("%dd %02dh %02dm %02ds", days, hours, minutes, secs)
    end

    return string.format("%02d:%02d:%02d", hours, minutes, secs)
end

local function GetRequest()
    return HttpRequest
        or request
        or http_request
        or (syn and syn.request)
        or (http and http.request)
end

local function VerifyKey(key)
    local req = GetRequest()

    if not req then
        return "error", "ไม่พบ HTTP Request"
    end

    local ok, response = pcall(function()
        return req({
            Url = API_VERIFY .. HttpService:UrlEncode(key) .. "&t=" .. tostring(os.time()),
            Method = "GET",
        })
    end)

    if not ok or not response then
        return "error", "เชื่อมต่อ API ไม่สำเร็จ"
    end

    local code = response.StatusCode

    if code == 401 or code == 403 or code == 404 then
        return "invalid", "คีย์ถูกปิดใช้งาน"
    end

    if code ~= 200 then
        return "error", "API Error: " .. tostring(code)
    end

    local decoded, data = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decoded or type(data) ~= "table" then
        return "error", "ข้อมูลจาก API ไม่ถูกต้อง"
    end

    if data.valid == true then
        return "valid", data
    end

    return "invalid", data
end

local function ApplyKeyData(data)
    local expire = NormalizeTime(
        data.expiresAt or data.expireAt or data.expires or data.expiry
    )

    local serverTime = NormalizeTime(data.serverTime or data.now or data.timestamp)
    if serverTime then
        TimeOffset = serverTime - os.time()
    end

    if expire then
        KeyExpireTime = expire

        local remaining = expire - Now()
        if not KeyTotalTime or remaining > KeyTotalTime then
            KeyTotalTime = remaining
        end
    end
end

