local function SetState(state)
    if not UI.Main then
        return
    end

    local p = Palette[state] or Palette.ok
    local info = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    TweenService:Create(UI.Stroke, info, {Color = p.main}):Play()
    TweenService:Create(UI.IconStroke, info, {Color = p.main}):Play()
    TweenService:Create(UI.Icon, info, {ImageColor3 = p.main}):Play()
    TweenService:Create(UI.Fill, info, {BackgroundColor3 = p.main}):Play()
    TweenService:Create(UI.Dot, info, {BackgroundColor3 = p.main}):Play()

    UI.Timer.TextColor3 = p.text
    UI.Status.Text = p.label
    UI.Status.TextColor3 = p.main
end

local function KickPlayer(reason)
    if Kicked then
        return
    end

    Kicked = true
    reason = reason or "คีย์หมดอายุ"

    pcall(function()
        SetState("bad")
        UI.Timer.Text = "00:00:00"
        UI.Status.Text = "KICKED"
        TweenService:Create(UI.Fill, TweenInfo.new(0.2), {Size = UDim2.new(0, 0, 1, 0)}):Play()
    end)

    task.wait(0.8)

    pcall(function()
        LocalPlayer:Kick("\n[Flexozy]\n" .. reason .. "\nกรุณาขอคีย์ใหม่ที่ " .. WEBSITE_LINK)
    end)

    task.wait(2)

    pcall(function()
        game:Shutdown()
    end)
end

