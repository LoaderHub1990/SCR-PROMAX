AutoTPSection:Button({Title="ไปล็อบบี้", Callback=function()
    local c=LP.Character; local hrp=c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local spawn
    if Lobby then
        for _,v in ipairs(Lobby:GetDescendants()) do
            if v:IsA("SpawnLocation") then spawn=v; break end
        end
        if not spawn then
            for _,v in ipairs(Lobby:GetDescendants()) do
                if v:IsA("BasePart") and (v.Name=="Spawn" or v.Name=="LobbySpawn" or v.Name:lower():find("spawn")) then spawn=v; break end
            end
        end
    end
    if not spawn then
        for _,v in ipairs(workspace:GetDescendants()) do
            if v:IsA("SpawnLocation") then spawn=v; break end
        end
    end
    if not spawn then WindUI:Notify({Title="Error", Content="No spawn found", Duration=3}) return end
    S.currentPadModel=nil; S.lastSurfacePosition=nil
    hrp.Anchored=true; hrp.Velocity=Vector3.zero
    for _,v in ipairs(c:GetDescendants()) do if v:IsA("BasePart") then v.Anchored=true end end
    if c.PrimaryPart then c:PivotTo(CFrame.new(spawn.Position+Vector3.new(0,3,0)))
    else hrp.CFrame=CFrame.new(spawn.Position+Vector3.new(0,3,0)) end
    task.wait(.1)
    for _,v in ipairs(c:GetDescendants()) do if v:IsA("BasePart") then v.Anchored=false end end
    WindUI:Notify({Title="Teleport", Content="Teleported to lobby", Duration=3})
end})

