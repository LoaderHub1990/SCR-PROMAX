local function startFly()
    S.FLYING=true
    local c=LP.Character
    if not c then return end
    local hrp=c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")
    local h=c:FindFirstChildOfClass("Humanoid")
    if not hrp or not h then return end
    h.AutoRotate=false
    flyBV=Instance.new("BodyVelocity"); flyBV.Parent=hrp
    flyBV.MaxForce=Vector3.new(9e9,9e9,9e9); flyBV.Velocity=Vector3.zero
    flyBG=Instance.new("BodyGyro"); flyBG.Parent=hrp
    flyBG.MaxTorque=Vector3.new(9e9,9e9,9e9); flyBG.P=90000; flyBG.CFrame=hrp.CFrame
    local keys={F=0,B=0,L=0,R=0,Q=0,E=0}
    local speeds = {
        [Enum.KeyCode.W]="F",[Enum.KeyCode.S]="B",[Enum.KeyCode.A]="L",
        [Enum.KeyCode.D]="R",[Enum.KeyCode.E]="Q",[Enum.KeyCode.Q]="E"
    }
    local conn1=UIS.InputBegan:Connect(function(i,gp)
        if gp then return end
        local k=speeds[i.KeyCode]
        if k then keys[k]= S.iyflyspeed * (k=="Q" and 2 or k=="E" and -2 or (k=="F" and 1 or k=="B" and -1 or k=="L" and -1 or 1)) end
        if i.KeyCode==Enum.KeyCode.E and S.QEfly then keys.Q=S.iyflyspeed*2 end
        if i.KeyCode==Enum.KeyCode.Q and S.QEfly then keys.E=-S.iyflyspeed*2 end
        pcall(function() Camera.CameraType=Enum.CameraType.Track end)
    end)
    local conn2=UIS.InputEnded:Connect(function(i)
        local k=speeds[i.KeyCode]
        if k then keys[k]=0 end
    end)
    local conn3=RS.RenderStepped:Connect(function()
        if not S.FLYING then return end
        local c2=LP.Character
        local hrp2=c2 and (c2:FindFirstChild("HumanoidRootPart") or c2:FindFirstChild("UpperTorso") or c2:FindFirstChild("Torso"))
        if not hrp2 or not flyBV or not flyBG then return end
        local h2=c2:FindFirstChildOfClass("Humanoid")
        if h2 then h2.PlatformStand=true; h2.AutoRotate=false end
        local cam=Camera.CFrame
        local move = cam.LookVector*(keys.F+keys.B)
            + cam.RightVector*(keys.L+keys.R)
            + cam.UpVector*(keys.Q+keys.E)
        if move.Magnitude>0 then
            flyBV.Velocity=move*50
            flyBG.CFrame=CFrame.lookAt(hrp2.Position, hrp2.Position + Vector3.new(move.X,0,move.Z).Unit)
        else flyBV.Velocity=Vector3.zero end
    end)
    flyConn=conn3
    table.insert(S.fly_conns,conn1)
    table.insert(S.fly_conns,conn2)
end

