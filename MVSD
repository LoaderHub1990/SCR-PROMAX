local function startGunAimkill(slowMode)
    if S.gunAimkill_task then task.cancel(S.gunAimkill_task) end

    S.gunAimkill_task = task.spawn(function()
        while (slowMode and S.gunAimkillSafeOn) or (not slowMode and S.gunAimkillXOn) do
            if getgenv().match and LP:GetAttribute("Match") then
                local c = LP.Character
                local gun = getEquippedGun()

                if not gun then
                    forceEquipGun()
                else
                    local origin = getCharRayOrigin(c)
                    if origin then
                        -- Cache ครั้งเดียวต่อ frame
                        local anim = ReplicatedStorage:FindFirstChild("Animations")
                        local shootAnim = anim and anim:FindFirstChild("Shoot")
                        local hum = c:FindFirstChildOfClass("Humanoid")
                        local animator = hum and hum:FindFirstChild("Animator")
                        local muzzle = gun:FindFirstChild("Muzzle", true)
                        local muzzlePos = muzzle and muzzle.WorldPosition or origin
                        local fire = gun:FindFirstChild("Fire")

                        -- Animation เล่นครั้งเดียวต่อ frame
                        if shootAnim and animator then
                            local tr = animator:LoadAnimation(shootAnim)
                            if tr then tr:Play() end
                        end

                        if fire and fire:IsA("Sound") then fire:Play() end

                        -- ===== ยิงทุก enemy ครั้งเดียวต่อ frame =====
                        for _, p in ipairs(S.enemies) do
                            if p ~= LP and p.Character and p.Character.Parent then
                                local ok = p.Team ~= LP.Team
                                if not p.Team then ok = true end
                                if ok then
                                    local pc = p.Character
                                    local ph = pc:FindFirstChild("Humanoid")
                                    local phrp = pc:FindFirstChild("HumanoidRootPart")
                                    if ph and phrp and ph.Health > 0 then
                                        local tgt = phrp.Position + Vector3.new(0, 2, 0)
                                        S.dmgind_suppress_self = true
                                        Remotes.ShootGun:FireServer(origin, tgt, phrp, tgt)
                                        S.dmgind_suppress_self = false
                                    end
                                end
                            end
                        end
                    end
                end
            end
            -- ===== รอ frame เท่านั้น (60/sec) =====
            RS.RenderStepped:Wait()
        end
    end)
end

local function stopGunAimkill()
    if S.gunAimkill_task then
        task.cancel(S.gunAimkill_task)
        S.gunAimkill_task = nil
    end
end

-- ===== Knife Aimkill =====
local function knifeAimkillFire()
    if not getgenv().match then return end
    local c=LP.Character; if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health<=0 then return end
    forceEquipKnife()
    local hrp=c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local origin=(hrp.CFrame*CFrame.new(0,0,hrp.Size.Z*.5)).Position
    for _,p in ipairs(S.enemies) do
        if p~=LP then
            local pc=p.Character
            local phrp=pc and pc:FindFirstChild("HumanoidRootPart")
            if phrp then
                local dir=(phrp.Position-origin).Unit
                pcall(ThrowStart.FireServer, ThrowStart, origin, dir)
                pcall(ThrowHit.FireServer, ThrowHit, phrp, phrp.Position)
                local spread=0.6
                local function coneDir(base, spread)
                    local theta=math.random()*math.pi*2
                    local phi=math.acos(1-math.random()*(1-math.cos(spread)))
                    local up=math.abs(base.Y)>.99 and Vector3.new(1,0,0) or Vector3.new(0,1,0)
                    local t1=base:Cross(up).Unit; local t2=t1:Cross(base).Unit
                    local sp=math.sin(phi)
                    return (base*math.cos(phi)+t1*sp*math.cos(theta)+t2*sp*math.sin(theta)).Unit
                end
                pcall(ThrowStart.FireServer, ThrowStart, origin, coneDir(dir,spread))
            end
        end
    end
end

local function startKnifeAimkillX()
    if S.knifeAimkill_conn then S.knifeAimkill_conn:Disconnect() end
    S.knifeAimkill_conn=RS.RenderStepped:Connect(function()
        if not S.autoKillKnifeX then return end
        knifeAimkillFire()
    end)
end
local function stopKnifeAimkillX()
