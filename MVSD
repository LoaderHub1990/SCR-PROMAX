-- ===== Auto Teleport (Duel Pad) =====
local Lobby = workspace:WaitForChild("Lobby", 10)
local padCounts = {DuelRing_1v1=1,DuelRing_2v2=2,DuelRing_3v3=3,DuelRing_4v4=4}
local PAD_OFFSET = 10

local function teleportToPad(padModel)
    local c=LP.Character; if not c then return end
    local hrp=c:FindFirstChild("HumanoidRootPart")
    if not hrp or not padModel or not padModel.PrimaryPart then return end
    local pos=padModel.PrimaryPart.Position
    S.lastSurfacePosition=pos
    for _,v in ipairs(c:GetDescendants()) do
        if v:IsA("BasePart") and v.Name~="GroundHitboxProxy" then v.Anchored=false end
    end
    local old=c:FindFirstChild("GroundHitboxProxy")
    if old then old:Destroy() end
    local proxy=Instance.new("Part")
    proxy.Name="GroundHitboxProxy"; proxy.Size=Vector3.new(4,4,4); proxy.Transparency=1
    proxy.CanCollide=false; proxy.CanQuery=true; proxy.CanTouch=true
    proxy.Anchored=true; proxy.Massless=true; proxy.CFrame=CFrame.new(pos); proxy.Parent=c
    local cf=CFrame.new(pos-Vector3.new(0,PAD_OFFSET,0))
    if c.PrimaryPart then c:PivotTo(cf) else hrp.CFrame=cf end
    task.wait(.1); hrp.Anchored=true
end

local function returnToSurface()
    local c=LP.Character; if not c then return end
    local hrp=c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local old=c:FindFirstChild("GroundHitboxProxy")
    if old then old:Destroy() end
    if S.lastSurfacePosition then
        local cf=CFrame.new(S.lastSurfacePosition+Vector3.new(0,3,0))
        if c.PrimaryPart then c:PivotTo(cf) else hrp.CFrame=cf end
    end
    task.wait(.1); hrp.Anchored=false
    S.lastSurfacePosition=nil
end

task.spawn(function()
    while true do
        if not LP:GetAttribute("Match") then
            if S.autoTeleport then
                local c=LP.Character
                local hrp=c and c:FindFirstChild("HumanoidRootPart")
                if S.currentPadModel and hrp then
                    local stillValid=false
                    for _,child in ipairs(Lobby:GetChildren()) do
                        if child.Name=="DuelRingsGroup" then
                            for k,v in pairs(padCounts) do
                                local ring=child:FindFirstChild(k)
                                local padModel=ring and ring:FindFirstChild(S.currentPadModel.Name)
                                if padModel then
                                    local total=0; local cap=v*2
                                    for _,m in ipairs(ring:GetChildren()) do
                                        if m:IsA("Model") and m.Name=="DuelPad" then
                                            total=total+(m:GetAttribute("CharacterCount") or 0)
                                        end
                                    end
                                    if total<cap then stillValid=true end
                                    break
                                end
                            end
                        end
                    end
                    if not stillValid then
                        S.currentPadModel=nil
                        local proxy=c:FindFirstChild("GroundHitboxProxy")
                        if proxy then proxy:Destroy() end
                    end
                end
                if not S.currentPadModel then
                    local found=false
                    for _,child in ipairs(Lobby:GetChildren()) do
                        if child.Name=="DuelRingsGroup" then
                            for k,v in pairs(padCounts) do
                                local ring=child:FindFirstChild(k)
                                if ring then
                                    local pads={}; local total=0; local cap=v*2
                                    for _,m in ipairs(ring:GetChildren()) do
                                        if m:IsA("Model") and m.Name=="DuelPad" then
                                            local cc=m:GetAttribute("CharacterCount") or 0
                                            total=total+cc
                                            table.insert(pads,{model=m,count=cc})
                                        end
                                    end
                                    if total==cap-1 then
                                        for _,p in ipairs(pads) do
                                            if v>p.count then
                                                teleportToPad(p.model)
                                                S.currentPadModel=p.model
                                                found=true
                                                task.wait(.5); break
                                            end
                                        end
                                    end
                                end
                                if found then break end
                            end
                        end
                        if found then break end
                    end
                end
            else
                S.currentPadModel=nil
            end
        elseif S.currentPadModel then
            S.currentPadModel=nil
            returnToSurface()
        end
        task.wait(.2)
    end
end)

-- ===== Block Projectile Render =====
local blockConns={}
local blockedRemotes={}
local function blockRemote(remote)
    if blockedRemotes[remote] then return end
    blockedRemotes[remote]=true
    pcall(function()
        local conns=getconnections(remote.OnClientEvent)
        for _,c in ipairs(conns) do
            if c.Function then pcall(function() hookfunction(c.Function, function() end) end) end
            pcall(function() c:Disconnect() end)
        end
    end)
end
local function blockStart()
    local function findRemotes()
        local t={}
        for _,name in ipairs({"RenderKnifeProjectile","RenderShroudProjectile"}) do
            local r=Remotes:FindFirstChild(name)
            if r then table.insert(t,r) end
        end
        return t
    end
    for _,r in ipairs(findRemotes()) do blockRemote(r) end
    local hb=RS.Heartbeat:Connect(function()
        if not S.blockProjectileRender then return end
        for _,r in ipairs(findRemotes()) do blockRemote(r) end
    end)
    table.insert(blockConns,hb)
end
local function blockStop()
    for _,c in ipairs(blockConns) do pcall(function() c:Disconnect() end) end
    table.clear(blockConns)
    blockedRemotes={}
end
getgenv()._blockStart=blockStart
getgenv()._blockStop=blockStop

