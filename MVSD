-- ===== LOS =====
local function hasLOS(from, to, char, target)
    local pr=RaycastParams.new()
    pr.FilterDescendantsInstances={char,target}
    pr.FilterType=Enum.RaycastFilterType.Exclude
    local r=workspace:Raycast(from, to-from, pr)
    if r and not r.Instance:IsDescendantOf(target) then return false end
    return true
end

local function isEnemyValid(p)
    if not p or p==LP then return false end
    local c=p.Character; if not c or c.Parent~=workspace then return false end
    if p.Team and p.Team==LP.Team then return false end
    local h=c:FindFirstChild("Humanoid"); local hrp=c:FindFirstChild("HumanoidRootPart")
    local my=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not h or not hrp or not my then return false end
    if h.Health<=0 then return false end
    if CS:HasTag(c,"Invulnerable") or CS:HasTag(c,"SpeedTrail") then return false end
    return true
end

-- ===== Autoshoot =====
local function startAutoshoot()
    if S.autoshoot_task then task.cancel(S.autoshoot_task) end
    S.autoshoot_task=task.spawn(function()
        local last=0
        while S.autoshoot_enabled do
            local c=LP.Character; local hrp=c and c:FindFirstChild("HumanoidRootPart")
            local h=c and c:FindFirstChild("Humanoid")
            if getgenv().match and hrp and h and h.Health>0 and S.autoshoot_cooldown<=tick()-last then
                local best,bd=nil,S.max_distance
                for _,p in ipairs(S.enemies) do
                    local pc=p.Character
                    local phrp=pc and pc:FindFirstChild("HumanoidRootPart")
                    local ph=pc and pc:FindFirstChild("Humanoid")
                    if phrp and ph and ph.Health>0 then
                        if not p.Team or p.Team~=LP.Team then
                            local d=(phrp.Position-hrp.Position).Magnitude
                            if d<bd and hasLOS(hrp.Position,phrp.Position,c,pc) then bd=d; best=p end
                        end
                    end
                end
                if best then
                    local g=getEquippedGun()
                    if g then
                        local o=getCharRayOrigin(c)
                        local t=best.Character.HumanoidRootPart
                        if o and t then
                            fireShootGun(o,t.Position,t,t.Position)
                            local f=g:FindFirstChild("Fire")
                            if f and f:IsA("Sound") then f:Play() end
                            last=tick()
                        end
                    end
                end
            end
            task.wait(.03)
        end
    end)
end
local function stopAutoshoot()
    if S.autoshoot_task then task.cancel(S.autoshoot_task); S.autoshoot_task=nil end
end

-- ===== Auto Throw =====
local ThrowStart=Remotes:WaitForChild("ThrowStart",5)
local ThrowHit=Remotes:WaitForChild("ThrowHit",5)
local function throwKnifeAt(target)
    local c=LP.Character; if not c then return end
    local tool=c:FindFirstChildOfClass("Tool")
    if not tool or not tool:FindFirstChild("RightHandle") then return end
    local hrp=target:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local o=getCharRayOrigin(c); if not o then return end
    local dir=(hrp.Position-o).Unit
    ThrowStart:FireServer(o,dir)
    local ok,KPC=pcall(function() return require(Modules.KnifeProjectileController) end)
    if not ok then return end
    local sp=tool:GetAttribute("ThrowSpeed") or 100
    local cl=tool.RightHandle:Clone()
    KPC({Speed=sp, KnifeProjectile=cl, Direction=dir, Origin=o}, function(hit)
        local i=hit and hit.Instance or nil; local p=hit and hit.Position or nil
        ThrowHit:FireServer(i,p)
    end)
end

local function startAutoThrow()
    if S.auto_throw_task then task.cancel(S.auto_throw_task) end
    S.auto_throw_task=task.spawn(function()
        while S.auto_throw_enabled do
            if tick()-S.throw_lastTime>=S.throw_cooldown then
                local c=LP.Character; local hrp=c and c:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local best,bd=nil,S.throw_distance
                    for _,p in ipairs(S.enemies) do
                        if p~=LP and p.Team~=LP.Team then
                            local pc=p.Character
                            local phrp=pc and pc:FindFirstChild("HumanoidRootPart")
                            local ph=pc and pc:FindFirstChild("Humanoid")
                            if phrp and ph and ph.Health>0 then
                                local d=(phrp.Position-hrp.Position).Magnitude
                                if d<bd and hasLOS(hrp.Position,phrp.Position,c,pc) then bd=d; best=pc end
                            end
                        end
                    end
                    if best then
                        forceEquipKnife(); task.wait(.05); throwKnifeAt(best)
                        S.throw_lastTime=tick()
                    end
                end
            end
            task.wait(.1)
        end
    end)
end
local function stopAutoThrow()
    if S.auto_throw_task then task.cancel(S.auto_throw_task); S.auto_throw_task=nil end
end

-- ===== Trigger Bot =====
local function triggerbotFire(p)
    local c=LP.Character
    if not c or not c:FindFirstChild("HumanoidRootPart") then S.triggerbot_firing=false; return end
    if not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then S.triggerbot_firing=false; return end
    local t=p.Character:FindFirstChild("LowerTorso") or p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Head")
    if t then
        local g=getEquippedGun()
        if g then
            local o=getCharRayOrigin(c)
            if o then
                fireShootGun(o,t.Position,t,t.Position)
                local f=g:FindFirstChild("Fire")
                if f and f:IsA("Sound") then f:Play() end
            end
        end
    else S.triggerbot_firing=false end
end

RS.Heartbeat:Connect(function()
    if not S.triggerbot_enabled or not getgenv().match or S.triggerbot_firing then return end
    local c=LP.Character; if not c then return end
    local m=UIS:GetMouseLocation()
    local ray=Camera:ViewportPointToRay(m.X,m.Y)
    local pr=RaycastParams.new()
    pr.FilterType=Enum.RaycastFilterType.Exclude
    pr.FilterDescendantsInstances={c}; pr.IgnoreWater=true
    local r=workspace:Raycast(ray.Origin,ray.Direction*2000,pr)
    if not r then return end
    local mdl=r.Instance:FindFirstAncestorOfClass("Model"); if not mdl then return end
    local pl=Players:GetPlayerFromCharacter(mdl); if not pl then return end
    if isEnemyValid(pl) then
        S.triggerbot_firing=true
        triggerbotFire(pl)
        task.delay(S.triggerbot_cooldown,function() S.triggerbot_firing=false end)
    end
end)

-- ===== Wallbang =====
local function getClosestEnemyToCursor()
    local c=LP.Character; local hrp=c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil,false end
    local m=UIS:GetMouseLocation()
    local best,bs=nil,1e999; local bOn=false
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP then
            local pc=p.Character
            local ph=pc and pc:FindFirstChildOfClass("Humanoid")
            local phrp=pc and pc:FindFirstChild("HumanoidRootPart")
            if ph and phrp and ph.Health>0 and pc.Parent==workspace then
                if not p.Team or not LP.Team or p.Team~=LP.Team then
                    local d=(phrp.Position-hrp.Position).Magnitude
                    if d<=1500 then
                        local sp,on=Camera:WorldToViewportPoint(phrp.Position)
                        local sc
                        if on then
                            local dx=sp.X-m.X; local dy=sp.Y-m.Y
                            sc=math.sqrt(dx*dx+dy*dy)
                        else sc=d+100000 end
                        if sc<bs then bs=sc; best=p; bOn=on end
                    end
                end
            end
        end
    end
    if not best then return nil,false end
    return best, bOn and bs<=20
end

local function wallbangFire()
    local n=tick()
    if n-S.wallbang_lastTime<S.wallbang_cooldown then return end
    S.wallbang_lastTime=n
    pcall(function()
        local c=LP.Character; if not c then return end
        local g=getEquippedGun(); if not g then return end
        local o=getCharRayOrigin(c); if not o then return end
        local tp,on=getClosestEnemyToCursor()
        local tPos,tInst
        if tp and on then
            local part=tp.Character:FindFirstChild("Head") or tp.Character:FindFirstChild("UpperTorso") or tp.Character:FindFirstChild("HumanoidRootPart")
            if part then tPos=part.Position; tInst=part end
        end
        if not tPos then
            local m=UIS:GetMouseLocation()
            local ray=Camera:ViewportPointToRay(m.X,m.Y)
            local pr=RaycastParams.new()
            pr.FilterDescendantsInstances={c}
            pr.FilterType=Enum.RaycastFilterType.Exclude; pr.IgnoreWater=true
            local r=workspace:Raycast(ray.Origin,ray.Direction*2000,pr)
            if r then tPos=r.Position; tInst=r.Instance
            else tPos=ray.Origin+ray.Direction*1000 end
        end
        if not tPos then return end
        S.dmgind_suppress_self=true
        if tInst then Remotes.ShootGun:FireServer(o,tPos,tInst,tPos)
        else Remotes.ShootGun:FireServer(o,tPos,nil,tPos) end
        S.dmgind_suppress_self=false
        local mz=g:FindFirstChild("Muzzle",true)
        local mp=mz and mz.WorldPosition or o
        bulletRenderer(mp,tPos)
        local f=g:FindFirstChild("Fire")
        if f and f:IsA("Sound") then f:Play() end
        if on and tp then showDamageIndicator(tPos) end
    end)
end

UIS.InputBegan:Connect(function(i,gp)
    if gp then return end
    if not S.wallbang_enabled then return end
    if i.UserInputType==Enum.UserInputType.MouseButton1 then
        S.wallbang_mouseDown=true; wallbangFire()
    end
