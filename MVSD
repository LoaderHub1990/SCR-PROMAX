local function createBeamPart(cf)
    local p=Instance.new("Part")
    p.Size=Vector3.new(.1,.1,.1); p.Transparency=1; p.CanCollide=false
    p.CanQuery=false; p.CanTouch=false; p.Anchored=true; p.CFrame=cf; p.Parent=workspace
    return p
end

local function bulletRenderer(from, to)
    local p1=createBeamPart(CFrame.lookAt(from,to)*CFrame.new(0,0,-1))
    local p2=createBeamPart(CFrame.new(to))
    local b=Instance.new("Beam")
    b.Texture=""; b.TextureLength=1; b.TextureMode=Enum.TextureMode.Stretch
    b.TextureSpeed=0; b.Color=ColorSequence.new(S.bulletTracerColor)
    b.LightEmission=1; b.LightInfluence=0; b.Brightness=5
    b.Width0=0; b.Width1=0
    local a1=Instance.new("Attachment",p1); local a2=Instance.new("Attachment",p2)
    b.Attachment0=a1; b.Attachment1=a2; b.Parent=p1
    local t1=TS:Create(b,TweenInfo.new(.05,Enum.EasingStyle.Cubic,Enum.EasingDirection.In),{Width0=.3,Width1=.6})
    local t2=TS:Create(b,TweenInfo.new(.1,Enum.EasingStyle.Cubic,Enum.EasingDirection.Out),{Width0=0,Width1=0})
    t1:Play(); t1.Completed:Connect(function() t2:Play() end)
    Debris:AddItem(p1,.3); Debris:AddItem(p2,.3)
end

