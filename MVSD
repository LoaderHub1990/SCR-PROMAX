-- ===== Shroud / blind =====
local ok, AbilityConfig = pcall(function() return require(ReplicatedStorage.Ability.AbilityConfig) end)
local ok2, ActivateShroud = pcall(function() return ReplicatedStorage.Ability:WaitForChild("ActivateShroud") end)

local function blind(target)
    if not target then return end
    local c=LP.Character; if not c then return end
    local tChar=target.Character
    if not tChar then return end
    local trhp=tChar:FindFirstChild("HumanoidRootPart")
    local crhp=c:FindFirstChild("HumanoidRootPart")
    if not trhp or not crhp then return end
    if getgenv().lowExecutorsShroud then
        ActivateShroud:FireServer(crhp.Position, (trhp.Position-crhp.Position).Unit)
        return
    end
    local ok3, rayMod = pcall(function() return require(Modules.CharacterRayOrigin) end)
    local ok4, shroudMod = pcall(function() return require(ReplicatedStorage.Ability.ShroudProjectileController) end)
    if ok3 and ok4 then
        local origin=rayMod(c)
        local dir=(trhp.Position-origin).Unit
        ActivateShroud:FireServer(origin, dir)
        shroudMod(origin, dir)
        return
    end
    getgenv().lowExecutorsShroud=true
    ActivateShroud:FireServer(crhp.Position, (trhp.Position-crhp.Position).Unit)
end

