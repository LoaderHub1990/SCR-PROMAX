local function gradientText(text, c1, c2)
    if c1==c2 then return string.format('<font color="rgb(%d,%d,%d)">%s</font>',
        math.floor(c1.R*255+.5), math.floor(c1.G*255+.5), math.floor(c1.B*255+.5), text) end
    local n=#text; if n==0 then return text end
    local r=""
    for i=1,n do
        local ch=text:sub(i,i); local t=(i-1)/math.max(1,n-1)
        r = r .. string.format('<font color="rgb(%d,%d,%d)">%s</font>',
            math.floor((c1.R*(1-t)+c2.R*t)*255+.5),
            math.floor((c1.G*(1-t)+c2.G*t)*255+.5),
            math.floor((c1.B*(1-t)+c2.B*t)*255+.5), ch)
    end
    return r
end

local function getCharRayOrigin(char)
    if not char then return nil end
    local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return nil end
    return (hrp.CFrame * CFrame.new(0,0,hrp.Size.Z/2)).Position
end

local function getEquippedGun()
    local c=LP.Character; if not c then return nil end
    local t=c:FindFirstChildOfClass("Tool")
    if t and t:FindFirstChild("Fire") and t:FindFirstChild("Reload") then return t end
    return nil
end

local function getGunFromBackpack()
    local c=LP.Character; local bp=LP:FindFirstChildOfClass("Backpack")
    if not c or not bp then return nil end
    local h=c:FindFirstChildOfClass("Humanoid"); if not h or h.Health<=0 then return nil end
    for _,t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") and t:FindFirstChild("Fire") and t:FindFirstChild("Reload") then
            h:EquipTool(t); task.wait(); return t
        end
    end
    return nil
end

local function forceEquipGun()
    local c=LP.Character; if not c then return false end
    local h=c:FindFirstChildOfClass("Humanoid"); if not h or h.Health<=0 then return false end
    if getEquippedGun() then return true end
    return getGunFromBackpack() ~= nil
end

local function getKnife()
    local c=LP.Character; local bp=LP:FindFirstChildOfClass("Backpack")
    if not c or not bp then return nil end
    for _,t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") and t:GetAttribute("EquipAnimation")=="Knife_Equip" then return t end
    end
    return nil
end

local function forceEquipKnife()
    local c=LP.Character; if not c then return false end
    local h=c:FindFirstChildOfClass("Humanoid"); if not h or h.Health<=0 then return false end
    local t=c:FindFirstChildOfClass("Tool")
    if t and t:GetAttribute("EquipAnimation")=="Knife_Equip" then return true end
    local k=getKnife()
    if k then h:EquipTool(k); return true end
    return false
end

-- ===== Damage Indicator =====
local function showDamageIndicator(pos, dmg)
    if not S.dmgind_enabled or not pos then return end
    dmg = dmg or S.dmgind_damage
    if S.dmgind_use_actual then
        local g=getEquippedGun()
        if g then
            for _,a in ipairs({"Damage","damage","DamagePerShot","GunDamage","BaseDamage"}) do
                local v=g:GetAttribute(a)
                if type(v)=="number" and v>0 then dmg=v; break end
            end
        end
    end
    local rot=(math.random()-.5)*60
    local scaleStart=2+(math.random()-.5)*.3
    local swing=8+math.random()*6
    local p=Instance.new("Part")
    p.Name="\000DmgProxy"; p.Size=Vector3.new(.1,.1,.1); p.Transparency=1
    p.Anchored=true; p.CanCollide=false; p.CanQuery=false; p.CanTouch=false
    p.CastShadow=false; p.Massless=true
    p.CFrame=CFrame.new(pos + Vector3.new((math.random()-.5)*1.5, math.random()*.8+.8, (math.random()-.5)*1.5))
    p.Parent=workspace
    local bb=Instance.new("BillboardGui")
    bb.Name="DmgBillboard"; bb.Size=UDim2.new(0,120,0,40); bb.AlwaysOnTop=true
    bb.LightInfluence=0; bb.MaxDistance=2000; bb.Adornee=p; bb.Parent=DmgIndGui
    local lbl=Instance.new("TextLabel")
    lbl.Size=UDim2.new(1,0,1,0); lbl.BackgroundTransparency=1; lbl.RichText=true
    lbl.TextColor3=Color3.new(1,1,1); lbl.TextSize=S.dmgind_textsize
    lbl.TextStrokeTransparency=0; lbl.TextStrokeColor3=Color3.new(0,0,0)
    lbl.Font=Enum.Font[S.dmgind_font] or Enum.Font.GothamBold
    lbl.Rotation=rot; lbl.Parent=bb
    lbl.Text=gradientText(tostring(math.floor(dmg)), S.dmgind_color_primary, S.dmgind_color_secondary)
    local st=tick(); local life=S.dmgind_lifetime; local base=S.dmgind_textsize
    task.spawn(function()
        while true do
            local e=tick()-st
            if e>=life or not p.Parent then break end
            local t=math.clamp(e/life,0,1)
            local ease=1-(1-t)*(1-t)
            p.CFrame=CFrame.new(pos + Vector3.new(0,ease*5+1,0))
            lbl.Rotation=rot+math.sin(t*math.pi*4)*swing*(1-t)
            local ss
            if t<.15 then ss=scaleStart+(1-scaleStart)*(1-math.pow(1-t/.15,3))
            elseif t<.7 then ss=1
            else local tt=(t-.7)/.3; ss=1-tt*tt*.3 end
            lbl.TextSize=math.max(1, math.floor(base*ss))
            local f=math.pow(t,1.5)
            lbl.TextTransparency=f; lbl.TextStrokeTransparency=f
            task.wait(.016)
        end
        if p.Parent then p:Destroy() end
        if bb.Parent then bb:Destroy() end
    end)
end

local function installDmgIndHook()
    if S.dmgind_hookInstalled then return end
    local ok,err=pcall(function()
        S.dmgind_metatable=getrawmetatable(game)
        S.dmgind_originalNamecall=S.dmgind_metatable.__namecall
        setreadonly(S.dmgind_metatable,false)
        S.dmgind_metatable.__namecall=newcclosure(function(self,...)
            if getnamecallmethod()=="FireServer" then
                local ok2 = not S.dmgind_suppress_self
                if ok2 then ok2 = typeof(self)=="Instance" and self.Name=="ShootGun" end
                if ok2 then
                    local args={...}
                    local a3=args[3]; local a4=args[4] or args[2]
                    local valid=a3
                    if a3 then valid=a4; if a4 then valid=typeof(a3)=="Instance" and typeof(a4)=="Vector3" end end
                    if valid then
                        local m=a3:FindFirstAncestorOfClass("Model")
                        if m then
                            local pl=Players:GetPlayerFromCharacter(m)
                            if pl and pl~=LP then showDamageIndicator(a4) end
                        end
                    end
                end
            end
            return S.dmgind_originalNamecall(self,...)
        end)
        setreadonly(S.dmgind_metatable,true)
        S.dmgind_hookInstalled=true
    end)
    if not ok then warn("[DmgInd] hook failed: "..tostring(err)) end
end

local function uninstallDmgIndHook()
    if not S.dmgind_hookInstalled then return end
    pcall(function()
        setreadonly(S.dmgind_metatable,false)
        S.dmgind_metatable.__namecall=S.dmgind_originalNamecall
        setreadonly(S.dmgind_metatable,true)
    end)
    S.dmgind_hookInstalled=false; S.dmgind_metatable=nil; S.dmgind_originalNamecall=nil
end

