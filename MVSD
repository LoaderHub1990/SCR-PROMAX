local function setupInvisible()
    S.invisible_originals={}
    local c=LP.Character; if not c then return end
    S.invisible_hum=c:FindFirstChildOfClass("Humanoid")
    S.invisible_hrp=c:FindFirstChild("HumanoidRootPart")
    for _,v in ipairs(c:GetDescendants()) do
        if v:IsA("BasePart") and v.Transparency==0 then
            table.insert(S.invisible_originals,v)
        end
    end
end

local function startInvisible()
    setupInvisible()
    if not S.invisible_hrp or not S.invisible_hum then return end
    for _,v in ipairs(S.invisible_originals) do
        if v and v.Parent and v.Transparency==0 then v.Transparency=.5 end
    end
    if S.invisible_conn then S.invisible_conn:Disconnect() end
    S.invisible_conn=RS.Heartbeat:Connect(function()
        if not S.invisible_enabled then return end
        local hrp=S.invisible_hrp; local h=S.invisible_hum
        if not hrp or not hrp.Parent or not h then return end
        local orig=hrp.CFrame
        local camOff=h.CameraOffset
        local hid=orig*CFrame.new(0,-200000,0)
        local pos=hid:ToObjectSpace(CFrame.new(orig.Position)).Position
        hrp.CFrame=hid; h.CameraOffset=pos
        RS.RenderStepped:Wait()
        if hrp and hrp.Parent then hrp.CFrame=orig end
        if h and h.Parent then h.CameraOffset=camOff end
    end)
end
local function stopInvisible()
    if S.invisible_conn then S.invisible_conn:Disconnect(); S.invisible_conn=nil end
    for _,v in ipairs(S.invisible_originals) do
        if v and v.Parent then v.Transparency=0 end
    end
end

-- ===== No Animation =====
local function isMovementAnim(name)
    local n=name:lower()
    return n:find("walk") or n:find("run") or n:find("idle")
end

local function stopNonCombatAnims(char)
    local h=char:FindFirstChildOfClass("Humanoid"); if not h then return end
    for _,t in ipairs(h:GetPlayingAnimationTracks()) do
        if isMovementAnim(t.Name) and not t.Name:lower():find("tool") then t:Stop() end
    end
end

local function applyNoAnim(char)
    if not char or not char.Parent then return end
    local anim=char:FindFirstChild("Animate")
    if anim and anim:IsA("LocalScript") then
        if not S.noanim_saved_animate[char] then S.noanim_saved_animate[char]=anim end
        anim.Disabled=true
    end
    for _,c in ipairs(S.noanim_connections) do pcall(function() c:Disconnect() end) end
    table.clear(S.noanim_connections)
    stopNonCombatAnims(char)
    if S.noanim_heartbeat then pcall(function() S.noanim_heartbeat:Disconnect() end) end
    S.noanim_heartbeat=RS.Heartbeat:Connect(function()
        if not S.noanim_enabled then return end
        if not char or not char.Parent then return end
        stopNonCombatAnims(char)
    end)
end

local function restoreNoAnim(char)
    if S.noanim_heartbeat then pcall(function() S.noanim_heartbeat:Disconnect() end); S.noanim_heartbeat=nil end
    for _,c in ipairs(S.noanim_connections) do pcall(function() c:Disconnect() end) end
    table.clear(S.noanim_connections)
    if not char then return end
    local a=S.noanim_saved_animate[char]
    if a and a.Parent then a.Disabled=false end
    S.noanim_saved_animate[char]=nil
end
_G.REMVSD.apply_noanim = applyNoAnim
_G.REMVSD.restore_noanim = restoreNoAnim

-- ===== Anti-Aim =====
local function startAntiAim()
    if S.antiAim_task then task.cancel(S.antiAim_task) end
    S.antiAim_task=task.spawn(function()
        while S.antiAimEnabled do
            if LP:GetAttribute("Match") then
                if not S.antiAim_active then
                    local c=LP.Character; local hrp=c and c:FindFirstChild("HumanoidRootPart")
                    if hrp then S.antiAim_originalCFrame=hrp.CFrame end
                    S.antiAim_active=true
                end
                local c=LP.Character; local hrp=c and c:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame=CFrame.new(Vector3.new(1e12,1e12,1e12))
                    hrp.Velocity=Vector3.zero
                end
                RS.RenderStepped:Wait()
            else
                if S.antiAim_active then
                    if S.antiAim_originalCFrame then
                        local c=LP.Character; local hrp=c and c:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            pcall(function()
                                hrp.Anchored=true; hrp.CFrame=S.antiAim_originalCFrame
                                task.wait(.1); hrp.Anchored=false
                            end)
                        end
                    end
                    S.antiAim_originalCFrame=nil; S.antiAim_active=false
                end
                task.wait(.2)
            end
        end
    end)
end
local function stopAntiAim()
    if S.antiAim_task then task.cancel(S.antiAim_task); S.antiAim_task=nil end
    if S.antiAim_originalCFrame then
        local c=LP.Character; local hrp=c and c:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                hrp.Anchored=true; hrp.CFrame=S.antiAim_originalCFrame
                task.wait(.1); hrp.Anchored=false
            end)
        end
    end
    S.antiAim_originalCFrame=nil; S.antiAim_active=false
end

