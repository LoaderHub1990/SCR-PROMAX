-- Post-Processing
local PostSection = MiscTab:Section({Title="เอฟเฟกต์ภาพ"})
local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
local sunRays = Lighting:FindFirstChildOfClass("SunRaysEffect")
PostSection:Toggle({Title="เอฟเฟกต์ Bloom", Value=bloom~=nil,
    Callback=function(v)
        if v then
            if not bloom then bloom=Instance.new("BloomEffect"); bloom.Parent=Lighting
                bloom.Intensity=.5; bloom.Size=24; bloom.Threshold=.95 end
        elseif bloom then bloom:Destroy(); bloom=nil end
    end})
PostSection:Slider({Title="ความแรง Bloom", Value={Min=0,Max=5,Default=.5},
    Callback=function(v) if bloom then bloom.Intensity=v end end})
PostSection:Toggle({Title="ปรับสีภาพ", Value=cc~=nil,
    Callback=function(v)
        if v then
            if not cc then cc=Instance.new("ColorCorrectionEffect"); cc.Parent=Lighting
                cc.Brightness=0; cc.Contrast=0; cc.Saturation=0; cc.TintColor=Color3.fromRGB(255,255,255) end
        elseif cc then cc:Destroy(); cc=nil end
    end})
PostSection:Slider({Title="ความสว่างสี", Value={Min=-1,Max=1,Default=0}, Callback=function(v) if cc then cc.Brightness=v end end})
PostSection:Slider({Title="คอนทราสต์สี", Value={Min=-1,Max=1,Default=0}, Callback=function(v) if cc then cc.Contrast=v end end})
PostSection:Slider({Title="ความอิ่มสี", Value={Min=-1,Max=1,Default=0}, Callback=function(v) if cc then cc.Saturation=v end end})
PostSection:Colorpicker({Title="สี Tint", Default=Color3.fromRGB(255,255,255), Callback=function(c) if cc then cc.TintColor=c end end})
PostSection:Toggle({Title="แสงอาทิตย์", Value=sunRays~=nil,
    Callback=function(v)
        if v then
            if not sunRays then sunRays=Instance.new("SunRaysEffect"); sunRays.Parent=Lighting
                sunRays.Intensity=.1; sunRays.Spread=1 end
        elseif sunRays then sunRays:Destroy(); sunRays=nil end
    end})
PostSection:Slider({Title="ความแรงแสงอาทิตย์", Value={Min=0,Max=1,Default=.1}, Callback=function(v) if sunRays then sunRays.Intensity=v end end})
PostSection:Button({Title="รีเซ็ตเอฟเฟกต์ภาพทั้งหมด",
    Callback=function()
        if bloom then bloom:Destroy(); bloom=nil end
        if cc then cc:Destroy(); cc=nil end
        if sunRays then sunRays:Destroy(); sunRays=nil end
    end})

