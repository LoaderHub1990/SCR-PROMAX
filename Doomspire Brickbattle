        WindUI:Notify({
            Title = "เปลี่ยน Rig",
            Content = "ไม่พบตัวละคร",
            Duration = 2,
            Icon = "x"
        })
        return
    end

    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    local remote =
        ReplicatedStorage:FindFirstChild("RigType")
        or ReplicatedStorage:FindFirstChild("ChangeRig")
        or ReplicatedStorage:FindFirstChild("SetRig")
        or ReplicatedStorage:FindFirstChild("ChangeRigType")

    if remote and remote:IsA("RemoteEvent") then
        pcall(function()
            remote:FireServer(rigType)
        end)

        WindUI:Notify({
            Title = "เปลี่ยน Rig",
            Content = "ส่งคำขอเปลี่ยนเป็น " .. rigType .. " แล้ว",
            Duration = 2,
            Icon = "check"
        })

        return
    end

    pcall(function()
        LocalPlayer.Character:BreakJoints()
    end)

    WindUI:Notify({
        Title = "เปลี่ยน Rig",
        Content = "ไม่พบระบบเปลี่ยน Rig จึงโหลดตัวละครใหม่",
        Duration = 3,
        Icon = "x"
    })
end

