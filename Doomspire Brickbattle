local function GetRequestFunction()
    if typeof(request) == "function" then
        return request
    end

    if typeof(http_request) == "function" then
        return http_request
    end

    if syn and typeof(syn.request) == "function" then
        return syn.request
    end

    if http and typeof(http.request) == "function" then
        return http.request
    end

    return nil
end

local function FormatNumber(n)
    local s = tostring(math.floor(n))
    local result = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (result:gsub("^,", ""))
end

local DiscordInfo = {
    Name = "Flexozy Community",
    Online = "N/A",
    Members = "N/A",
    Inviter = "-",
    Icon = CONFIG.Logo,
}

local function FetchDiscord()
    local Req = GetRequestFunction()

    if not Req then
        return
    end

    local ok, res = pcall(Req, {
        Url = "https://discord.com/api/v10/invites/"
            .. CONFIG.DiscordCode
            .. "?with_counts=true",
        Method = "GET"
    })

    if not (ok and res and res.StatusCode == 200 and res.Body) then
        return
    end

    local okJson, data = pcall(function()
        return HttpService:JSONDecode(res.Body)
    end)

    if not okJson or type(data) ~= "table" then
        return
    end

    local guild = data.guild

    if type(guild) == "table" and guild.name then
        DiscordInfo.Name = tostring(guild.name)
    end

    DiscordInfo.Online = FormatNumber(data.approximate_presence_count or 0)
    DiscordInfo.Members = FormatNumber(data.approximate_member_count or 0)

    local inviter = data.inviter

    if type(inviter) == "table" then
        DiscordInfo.Inviter = tostring(
            inviter.global_name
            or inviter.username
            or "Unknown"
        )
    end

    local getAsset = getcustomasset or getsynasset

    if type(guild) == "table"
        and guild.icon
        and writefile
        and getAsset then

        pcall(function()
            local iconRes = Req({
                Url = string.format(
                    "https://cdn.discordapp.com/icons/%s/%s.png?size=128",
                    tostring(guild.id),
                    tostring(guild.icon)
                ),
                Method = "GET"
            })

            if iconRes
                and iconRes.StatusCode == 200
                and iconRes.Body
                and #iconRes.Body > 0 then

                local fileName = "flexozy_discord_" .. CONFIG.DiscordCode .. ".png"
                writefile(fileName, iconRes.Body)
                DiscordInfo.Icon = getAsset(fileName)
            end
        end)
    end
end

pcall(FetchDiscord)

