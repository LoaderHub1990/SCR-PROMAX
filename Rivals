local function getSlotNumber()
    return slots[getgenv().Config.WeaponSlot] or 1
end

local function updateStatus()
    if getgenv().Config.UIOpen then
        toggleBtn.Text = "เปิดใช้งาน"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 60, 35)
        toggleStroke.Color = Color3.fromRGB(90, 220, 120)
    else
        toggleBtn.Text = "ปิดใช้งาน"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 30, 32)
        toggleStroke.Color = Color3.fromRGB(220, 90, 90)
    end
end

local function updateWeaponBtn()
    local selected = slotsList[currentSlotIndex]
    if selected then
        weaponBtn.Text = selected.Name
        getgenv().Config.WeaponSlot = selected.Value
    end
end

local function keyName(key)
    local name = key.Name
    if name == "RightShift" then return "RightShift"
    elseif name == "LeftShift" then return "LeftShift"
    elseif name == "RightControl" then return "RightCtrl"
    elseif name == "LeftControl" then return "LeftCtrl"
    elseif name == "RightAlt" then return "RightAlt"
    elseif name == "LeftAlt" then return "LeftAlt"
    elseif name == "Space" then return "Space"
    end
    return name
end

local function equipCurrentWeapon()
    local localFighter = FighterController.LocalFighter
    if localFighter then
        pcall(function()
            localFighter:EquipItem(getSlotNumber())
        end)
    end
end

local function switchWeapon()
    currentSlotIndex = currentSlotIndex % #slotsList + 1
    updateWeaponBtn()
    equipCurrentWeapon()
end

local function toggleEnabled()
    if firstToggle then
        firstToggle = false
        getgenv().Config.Enabled = true
        getgenv().Config.UIOpen = true
        updateStatus()
        return
    end

    local newState = not getgenv().Config.Enabled
    getgenv().Config.Enabled = newState
    getgenv().Config.UIOpen = newState
    updateStatus()
end

