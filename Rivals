track(uis.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    if listeningForToggleKey then
        getgenv().Config.ToggleKey = input.KeyCode
        toggleKeyBtn.Text = keyName(input.KeyCode)
        listeningForToggleKey = false
        toggleKeyStroke.Color = Color3.fromRGB(210, 210, 210)
        return
    end

    if listeningForWeaponKey then
        getgenv().Config.WeaponKey = input.KeyCode
        weaponKeyBtn.Text = keyName(input.KeyCode)
        listeningForWeaponKey = false
        weaponKeyStroke.Color = Color3.fromRGB(210, 210, 210)
        return
    end

    if input.KeyCode == getgenv().Config.ToggleKey then
        local now = tick()
        if now - lastToggleTime < TOGGLE_DEBOUNCE then
            return
        end
        lastToggleTime = now
        toggleEnabled()
        return
    end

    if input.KeyCode == getgenv().Config.WeaponKey then
        switchWeapon()
        return
    end
end))

