local function mapDropdownValue(key, value)
	local mapping = DropdownValueMaps[key]
	return mapping and mapping[value] or value
end

local function toSelectionMap(key, value)
	if type(value) ~= "table" then
		return mapDropdownValue(key, value)
	end

	local map = {}

	for _, item in ipairs(value) do
		map[mapDropdownValue(key, item)] = true
	end

	if next(map) == nil then
		for item, selected in pairs(value) do
			if type(item) == "string" and selected == true then
				map[mapDropdownValue(key, item)] = true
			end
		end
	end

	return map
end

local function bindDropdown(tab, key, title, values, default, multi, desc)
	Options[key] = {
		Value = multi and toSelectionMap(key, default) or mapDropdownValue(key, default)
	}

	local element = tab:Dropdown({
		Flag = key,
		Title = title,
		Desc = desc,
		Values = values,
		Value = default,
		Multi = multi == true,
		AllowNone = false,
		Callback = function(value)
			Options[key].Value = multi and toSelectionMap(key, value) or mapDropdownValue(key, value)
		end,
	})

	Elements[key] = element
	return Options[key]
end

local function bindSlider(tab, key, title, desc, min, max, default, step, suffix)
	Options[key] = { Value = default }

	local element = tab:Slider({
		Flag = key,
		Title = title,
		Desc = desc,
		Step = step or 1,
		Value = {
			Min = min,
			Max = max,
			Default = default,
		},
		Callback = function(value)
			Options[key].Value = value
		end,
	})

	Elements[key] = element
	return Options[key]
end

local function bindInput(tab, key, title, desc, default, placeholder)
	Options[key] = { Value = default }

	local element = tab:Input({
		Flag = key,
		Title = title,
		Desc = desc,
		Value = tostring(default or ""),
		Placeholder = placeholder or tostring(default or ""),
		Callback = function(value)
			Options[key].Value = value
		end,
	})

	Elements[key] = element
	return Options[key]
end

