local function bindToggle(tab, key, title, desc, default)
	local state = { Value = default == true, _changed = {} }

	function state:OnChanged(callback)
		if type(callback) == "function" then
			table.insert(self._changed, callback)
		end
	end

	Toggles[key] = state

	local element = tab:Toggle({
		Flag = key,
		Title = title,
		Desc = desc,
		Value = state.Value,
		Callback = function(value)
			state.Value = value == true
			for _, callback in ipairs(state._changed) do
				pcall(callback, state.Value)
			end
		end,
	})

	Elements[key] = element
	return state
end

